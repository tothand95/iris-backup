{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./out-tsc/storybook",
    "types": ["node"],
    "moduleResolution": "bundler"
  },
  "include": [".storybook/preview.ts", "Storybook/**/*.ts", "Components/src/**/*.ts", "Components/table/src/**/*.ts"],
  "exclude": ["Components/src/**/*.spec.ts", "Storybook/storybook-host/main.ts"]
}
