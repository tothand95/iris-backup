{
  "endOfLine": "auto",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 150,
  "singleQuote": true,
  "trailingComma": "none",
  "semi": true,
  "bracketSpacing": true,
  "bracketSameLine": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ]
}
